# 1. Ignorar absolutamente todo
*

# 2. No ignorar los directorios (necesario para poder entrar en ellos)
!*/

# 3. Las carpetas src de cualquier proyecto, serán admititdas
!/*/src/*

# 4. Ficheros admitidos de cualquier directorio
!/*/*.qbas
!/*/*.bas
!/*/*.sh
!/*/*.
!/*/*.md

# 4b. Gráficos de los proyectos CPCtelera: los PNG (y su script) en img/
#     y la configuración que los convierte a C (solo en los proyectos que la usan)
!/*/img/*
!/claudegame/cfg/image_conversion.mk
!/vaqueros/cfg/image_conversion.mk

# 4c. kung-fu: generador en Python (sprites, fondo, música...) y su configuración
#     (PROJNAME sin guion y el código en 0x0100, que cpct_mkproject no pondría)
#     y los datos generados (así compila sin tener que ejecutar Python)
!/kung-fu/gen/*.py
!/kung-fu/cfg/build_config.mk
!/kung-fu/src/datos/*

# 5. Ficheros admitidos de la raíz:
!*.sh
!*.
!*.md
!.gitignore
!.gitattributes
!cpc.conf.example